<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- agent-bridge を常駐させるLaunchAgentの雛形。/Users/YOU と各値を書き換えて使う。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tetetratra.smart-speaker.agent-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/.local/share/mise/installs/node/22/bin/node</string>
    <string>/Users/YOU/p/smart-speaker/services/agent-bridge/src/main.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/p/smart-speaker/services/agent-bridge</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOU/.local/share/mise/installs/node/22/bin:/Users/YOU/.local/bin:/usr/bin:/bin</string>
    <key>LANG</key>
    <string>ja_JP.UTF-8</string>
    <key>AGENT_BRIDGE_LISTEN</key>
    <string>100.x.y.z:8787</string>
    <key>AGENT_BRIDGE_TOKEN_FILE</key>
    <string>/Users/YOU/.config/smart-speaker/agent-bridge-token</string>
    <key>AGENT_BRIDGE_WORKDIR</key>
    <string>/Users/YOU/work</string>
    <key>AGENT_BRIDGE_EVENTS_URL</key>
    <string>http://100.a.b.c:8081/api/agent-events</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/smart-speaker-agent-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/smart-speaker-agent-bridge.log</string>
</dict>
</plist>
