# サーバーに渡すシークレット。このファイルを .env にコピーして値を書きます（.env は Git の管理外）。
#   cp .env.sample .env
# docker compose が .env を読み、ここに書いた変数をすべてサーバーのコンテナに渡します。
# 新しい変数を足すときも、docker-compose.yml を変える必要はありません。
# 書き方は「名前=値」です（export は付けません）。使わない機能の行は、空のままか消してかまいません。

# OpenAI の API キー（必須）
OPENAI_API_KEY=

# ElevenLabs で読み上げる場合
ELEVENLABS_API_KEY=

# SwitchBot で家電を操作する場合
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
# Webhookで状態を受け取る場合。openssl rand -hex 32 などで作る秘密の値（未設定ならHub 2を定期取得）
SWITCHBOT_WEBHOOK_TOKEN=

# Google Calendar を使う場合
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude Code 連携を使う場合。Mac の agent-bridge と同じ値にします（openssl rand -hex 32 などで作る）
AGENT_BRIDGE_TOKEN=

# config.yaml の ${...} で参照する値（MCP サーバーのシークレットなど）も、好きな名前でここに書けます
